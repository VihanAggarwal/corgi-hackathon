# Copy to .env.local and fill in. NEVER commit .env.local
#
# .env.local is gitignored. .env.example is committed deliberately so a new
# machine knows what it needs without anyone having to ask in the group chat.

# --- Supabase ---------------------------------------------------------------
# Run contracts/schema.sql in the SQL editor once before anyone starts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Must never reach the client bundle. Track C verifies this.
SUPABASE_SERVICE_ROLE_KEY=

# --- Models -----------------------------------------------------------------
# Used by the corpus extraction pass, the renderer, and the portrait.
ANTHROPIC_API_KEY=

# --- Corpus -----------------------------------------------------------------
# Licensed Places API. There is no scraping path anywhere in this repo.
GOOGLE_PLACES_API_KEY=

# Set to 1 to run the corpus pipeline with zero network calls. Every downstream
# stage stays testable without keys, and the demo survives dead venue wifi.
CORPUS_DRY_RUN=

# Neighborhood the corpus is scoped to. Defaults to the Lower East Side.
CORPUS_NEIGHBORHOOD=
CORPUS_LAT=
CORPUS_LNG=
CORPUS_RADIUS_M=

# --- Merge ------------------------------------------------------------------
# We have Agent Handler and Gateway. We do NOT have the Unified API.
# Read docs/TRACK-C-MERGE-BRIEF.md before wiring any of this.

# Agent Handler is MCP only. Our server must be the MCP client, calling tools
# deterministically. Never hand this to an agent loop: HRIS dietary and
# religious records are Article 9 data and must never enter a model's context.
MERGE_AGENT_HANDLER_API_KEY=
MERGE_AGENT_HANDLER_MCP_URL=

# Gateway routes model calls only. It never sees HRIS data, so it carries no
# Article 9 exposure. Unset means talk to Anthropic directly.
MERGE_GATEWAY_BASE_URL=
MERGE_GATEWAY_API_KEY=

# --- Photon (Spectrum) --------------------------------------------------------
# Verified: Photon's platform is the spectrum-ts SDK (photon.codes). The agent
# is a LONG-RUNNING process on the presenter's laptop, not a Vercel route:
#   npx tsx integrations/photon/spectrum-runner.ts
# Credentials come from the Photon dashboard.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Handle that counts as tagging the agent in a group thread. Default: tastetwins
PHOTON_AGENT_HANDLE=

# --- Surfaces ---------------------------------------------------------------
# Absolute origin for Open Graph images. If this is unset AND we are not on
# Vercel, a link pasted into a Messages thread renders as a bare blue link
# instead of a card, which silently removes the entire growth loop. Vercel's
# own domain is used as a fallback, so this is belt and braces.
NEXT_PUBLIC_SITE_URL=

# Set to 1 to prove the twins-disabled path: no twin language may appear
# anywhere in the UI when this is on.
NEXT_PUBLIC_TWINS_DISABLED=
